@startuml
title 自学 Agent 标准流程（AI Agent 架构学习 / PDF 专用）

skinparam backgroundColor #FAFCFC
skinparam shadowing false
skinparam defaultFontName Microsoft YaHei
skinparam activity {
  BackgroundColor #FFFFFF
  BorderColor #2F6F6A
  FontColor #102A43
}

start

partition "TypeScript Web 界面" {
  :用户上传 AI Agent 课程 PDF;
}

partition "Express API + CLI" {
  :校验扩展名为 .pdf;
  :保存到 data/uploads/;
  :调用 Python CLI;
}

partition "StudyRuntime（唯一执行入口）" {
  :冻结工具快照;
  :仅允许 ingest_pdf;
  :校验工具参数;
}

partition "PDF Reader" {
  :检查文件存在、大小和文本层;
  if (有可提取文本？) then (是)
    :pypdf 提取、清洗并切分 SourceChunk;
  else (否)
    :返回稳定错误码;
    stop
  endif
}

partition "SQLite" {
  :保存 Source、规范化文本与 SourceChunk;
}

partition "配置化学习画像" {
  :读取 config/study_profile.toml;
  note right
    可配置：
    - 学习主题与范围
    - 提炼提示词
    - 出题提示词
    - 评分提示词
  end note
}

partition "模型驱动的知识提炼" {
  if (模型服务已配置？) then (是)
    :发送学习画像提示词 + 不可信文本块;
    :Pydantic 校验 ConceptResponse;
    :校验 chunk_index 来源定位;
    :替换该资料的 Concept;
  else (否)
    :返回 MODEL_UNAVAILABLE;
    stop
  endif
}

partition "模型驱动的出题" {
  :发送学习画像提示词 + 已保存 Concept;
  :Pydantic 校验 QuestionResponse;
    :校验 concept_id;
    :Runtime 按 concept_id 写入规范 source_refs;
  :保存 Question 与来源引用;
}

partition "学习闭环" {
  :按掌握度、最近作答时间、创建时间选择题目;
  :用户提交答案;
  if (单选或判断题？) then (是)
    :规范化后精确比对答案;
  else (简答题)
    :模型结构化评分;
  endif
  :保存 Attempt;
  :更新 Concept 掌握度;
  :写入最小审计事件;
}

stop
@enduml
